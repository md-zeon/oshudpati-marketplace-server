{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "oshudpati-marketplace-server",
  "version": "1.0.0",
  "description": "Oshudpati Marketplace Server",
  "main": "index.js",
  "scripts": {
    "dev": "pnpm dlx tsx watch src/server.ts",
    "seed:admin": "pnpm dlx tsx src/scripts/seedAdmin.ts",
    "test": "echo \"Error: no test specified\" && exit 1",
    "build": "prisma generate && tsup src/server.ts --format esm --platform node --target node20 --outDir api --external pg-native",
    "postinstall": "prisma generate"
  },
  "keywords": [],
  "author": "Zeanur Rahaman Zeon <zeon.cse@gmail.com>",
  "license": "ISC",
  "packageManager": "pnpm@11.2.1",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.2.1",
      "onFail": "download"
    }
  },
  "type": "module",
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^25.9.1",
    "@types/nodemailer": "^8.0.0",
    "@types/pg": "^8.20.0",
    "prisma": "^7.8.0",
    "tsup": "^8.5.1",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "better-auth": "^1.6.11",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "nodemailer": "^8.0.8",
    "pg": "^8.21.0",
    "zod": "^4.4.3"
  }
}
